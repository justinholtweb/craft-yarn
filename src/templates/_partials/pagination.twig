{# Page links that keep every filter already in the URL. #}
{% if pages > 1 %}
    {% set query = craft.app.request.queryParams %}
    <nav class="pagination yarn-pagination" aria-label="{{ "Pages"|t('yarn') }}">
        {% if page > 1 %}
            <a class="btn" href="?{{ query|merge({ page: page - 1 })|url_encode }}">{{ "Previous"|t('yarn') }}</a>
        {% endif %}

        <span class="light">{{ "Page {page} of {pages} · {total} rows"|t('yarn', { page: page, pages: pages, total: total }) }}</span>

        {% if page < pages %}
            <a class="btn" href="?{{ query|merge({ page: page + 1 })|url_encode }}">{{ "Next"|t('yarn') }}</a>
        {% endif %}
    </nav>
{% endif %}
