{# The Relations panel in an element edit screen's sidebar.

   Never builds the whole-site graph: this renders on every element edit screen on the site, and a
   graph build is not something to do on the way to an edit form. Relation fields come straight
   from the relations table; reference tags and hard-coded links (when those sources are on) come
   from a scan of only the rows that could mention this element, cached until the next save. The
   full picture — every edge, grouped by field — is one click away. #}
{% do view.registerAssetBundle("justinholtweb\\yarn\\web\\assets\\cp\\CpAsset") %}

{% set linkedBy = usages|filter(u => u.kind != 'field')|length %}

<div class="yarn yarn-panel">
    <h3>{{ "Relations"|t('yarn') }}</h3>

    {% if usages|length %}
        <p class="yarn-panel-warning">
            {% if linkedBy %}
                {{ "{count} element(s) point at this. Deleting it will break their links and empty any fields that hold it."|t('yarn', { count: usages|length }) }}
            {% else %}
                {{ "{count} element(s) point at this. Deleting it will empty those fields."|t('yarn', { count: usages|length }) }}
            {% endif %}
        </p>
    {% endif %}

    <div class="yarn-panel-counts">
        <div class="yarn-panel-count">
            <b>{{ uses|length }}</b>
            {{ "points at"|t('yarn') }}
        </div>
        <div class="yarn-panel-count">
            <b>{{ usages|length }}</b>
            {{ "pointed at by"|t('yarn') }}
        </div>
    </div>

    <a class="btn small" href="{{ yarnUrl }}">{{ "See the whole thread"|t('yarn') }}</a>
</div>
