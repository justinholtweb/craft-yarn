{% extends "_layouts/cp" %}
{% import "_includes/forms" as forms %}

{% set title = "Asset usage"|t('yarn') %}
{% set selectedSubnavItem = 'assets' %}
{% do view.registerAssetBundle("justinholtweb\\yarn\\web\\assets\\cp\\CpAsset") %}

{% block content %}
    <div class="yarn">
        {% include 'yarn/_partials/toolbar' %}

        <div class="yarn-stats">
            <div class="yarn-stat">
                <div class="yarn-stat-value">{{ total|number }}</div>
                <div class="yarn-stat-label">{{ "Assets in view"|t('yarn') }}</div>
            </div>
            <div class="yarn-stat">
                <div class="yarn-stat-value">{{ unused|number }}</div>
                <div class="yarn-stat-label">{{ "Nothing uses them"|t('yarn') }}</div>
            </div>
        </div>

        <form method="get" class="yarn-toolbar">
            <input type="hidden" name="site" value="{{ site.handle }}">

            <div>
                <label class="yarn-toolbar-label" for="group">{{ "Volume"|t('yarn') }}</label>
                {{ forms.select({
                    id: 'group',
                    name: 'group',
                    value: group,
                    options: [{ label: "All volumes"|t('yarn'), value: '' }]|merge(volumes|map(volume => {
                        label: volume.label ~ ' (' ~ volume.count ~ ')',
                        value: volume.key,
                    })),
                }) }}
            </div>

            <div class="yarn-toolbar-field">
                {{ forms.checkbox({
                    id: 'unused',
                    name: 'unused',
                    label: "Only the unused ones"|t('yarn'),
                    checked: unusedOnly,
                }) }}
            </div>

            <div>
                <button type="submit" class="btn submit">{{ "Filter"|t('yarn') }}</button>
            </div>
        </form>

        <div class="readable yarn-intro">
            <p class="light">
                {{ "“Unused” means nothing Yarn scans reaches it. An asset used only from a template, a CSS background or a source Yarn is not scanning will appear here — check before you delete."|t('yarn') }}
            </p>
        </div>

        {% if rows is empty %}
            <div class="yarn-empty">{{ "No assets match that."|t('yarn') }}</div>
        {% else %}
            <table class="data fullwidth yarn-table">
                <thead>
                    <tr>
                        <th>{{ "Asset"|t('yarn') }}</th>
                        <th class="yarn-col-narrow">{{ "Uses"|t('yarn') }}</th>
                        <th>{{ "Used by"|t('yarn') }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for row in rows %}
                        <tr>
                            <td>{% include 'yarn/_partials/node' with { node: row.node } %}</td>
                            <td>
                                {% if row.uses == 0 %}
                                    <span class="yarn-health" data-health="deleted">{{ "unused"|t('yarn') }}</span>
                                {% else %}
                                    {{ row.uses }}
                                {% endif %}
                            </td>
                            <td>
                                {% for user in row.usedBy|slice(0, 6) %}
                                    <div>{% include 'yarn/_partials/node' with { node: user, showGroup: false } %}</div>
                                {% endfor %}
                                {% if row.usedBy|length > 6 %}
                                    <div class="yarn-via">
                                        <a href="{{ row.node.yarnUrl(site.id) }}">
                                            {{ "and {count} more"|t('yarn', { count: row.usedBy|length - 6 }) }}
                                        </a>
                                    </div>
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>

            {% include 'yarn/_partials/pagination' %}
        {% endif %}
    </div>
{% endblock %}
