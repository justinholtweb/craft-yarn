{% extends "_layouts/cp" %}

{% set title = "Globals"|t('yarn') %}
{% set selectedSubnavItem = 'globals' %}
{% do view.registerAssetBundle("justinholtweb\\yarn\\web\\assets\\cp\\CpAsset") %}

{% block content %}
    <div class="yarn">
        {% include 'yarn/_partials/toolbar' %}

        <div class="readable yarn-intro">
            <p class="light">
                {{ "Global sets relate like any other element, and what they relate to appears on every page that renders them. This is the list that explains why an image you thought was unused is on eleven thousand pages."|t('yarn') }}
            </p>
        </div>

        {% if rows is empty %}
            <div class="yarn-empty">{{ "This site has no global sets."|t('yarn') }}</div>
        {% endif %}

        {% for row in rows %}
            <div class="yarn-group">
                <div class="yarn-group-head">
                    <h3>{% include 'yarn/_partials/node' with { node: row.node, showGroup: false } %}</h3>
                    <span class="light">
                        {{ "{direct} direct · {reach} within two hops"|t('yarn', { direct: row.direct|length, reach: row.reach }) }}
                    </span>
                    <a class="btn small" href="{{ row.node.cpEditUrl() }}">{{ "Edit"|t('yarn') }}</a>
                </div>

                {% if row.direct is empty %}
                    <p class="light">{{ "Nothing related."|t('yarn') }}</p>
                {% else %}
                    <table class="data fullwidth yarn-table">
                        <tbody>
                            {% for node in row.direct %}
                                <tr>
                                    <td>{% include 'yarn/_partials/node' with { node: node } %}</td>
                                    <td class="light yarn-col-count">
                                        {{ "{count} other relations"|t('yarn', { count: node.inCount + node.outCount - 1 }) }}
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                {% endif %}
            </div>
        {% endfor %}
    </div>
{% endblock %}
