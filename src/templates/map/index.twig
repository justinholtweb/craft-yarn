{% extends "_layouts/cp" %}
{% import "_includes/forms" as forms %}

{% set title = "Yarn"|t('yarn') %}
{% set selectedSubnavItem = 'map' %}
{% do view.registerAssetBundle("justinholtweb\\yarn\\web\\assets\\cp\\CpAsset") %}

{% set kinds = {
    entry: "Entries"|t('yarn'),
    asset: "Assets"|t('yarn'),
    category: "Categories"|t('yarn'),
    tag: "Tags"|t('yarn'),
    user: "Users"|t('yarn'),
    global: "Globals"|t('yarn'),
    other: "Other"|t('yarn'),
} %}

{% block content %}
    <div class="yarn">
        {% include 'yarn/_partials/toolbar' %}
        {% include 'yarn/_partials/stats' %}

        <div class="yarn-toolbar">
            <div class="yarn-toolbar-field yarn-toolbar-field--wide">
                <label class="yarn-toolbar-label" for="yarn-groups">{{ "Show only"|t('yarn') }}</label>
                {# Craft's own multi-select. A bare <select multiple> renders as "0 selected" in
                   Chrome and as a two-row scrolling list in Firefox, and neither looks like Craft. #}
                {{ forms.selectize({
                    id: 'yarn-groups',
                    multi: true,
                    options: groups|map(group => { value: group.key, label: group.label ~ ' (' ~ group.count ~ ')' }),
                    values: [],
                    selectizeOptions: { placeholder: "All sources"|t('yarn') },
                    inputAttributes: { data: { 'yarn-groups': true, 'yarn-reload': true } },
                }) }}
            </div>

            <div class="yarn-toolbar-field">
                <label class="yarn-toolbar-label" for="yarn-search">{{ "Find"|t('yarn') }}</label>
                {{ forms.text({
                    id: 'yarn-search',
                    type: 'search',
                    placeholder: "Highlight by name"|t('yarn'),
                    inputAttributes: { data: { 'yarn-search': true } },
                }) }}
            </div>

            <div class="yarn-toolbar-field">
                {# On by default. The map is a picture of relations, and an element with none is a
                   dot with no thread attached — on a normal site there are thousands of them, and
                   they crowd out the part anybody came to look at. The count is on the cards
                   above, and the list of them is under Findings. #}
                {{ forms.checkbox({
                    id: 'yarn-hide-orphans',
                    label: "Hide unconnected"|t('yarn'),
                    checked: true,
                    inputAttributes: { data: { 'yarn-hide-orphans': true, 'yarn-reload': true } },
                }) }}
            </div>

            <div class="yarn-toolbar-field" data-yarn-focus hidden>
                <span class="yarn-toolbar-label">{{ "Focused on"|t('yarn') }}</span>
                <span data-yarn-focus-label></span>
                <button type="button" class="btn small" data-yarn-clear-focus>{{ "Show everything"|t('yarn') }}</button>
            </div>
        </div>

        <div class="yarn-map" data-yarn-map>
            {# The payload the renderer reads. JSON in a script element, because a <script> holds
               raw text and HTML entities inside it are never decoded. #}
            <script type="application/json" data-yarn-config>{{ {
                site: site.handle,
                depth: 2,
                focus: null,
                maxNodes: maxNodes,
                elementUrlTemplate: cpUrl('yarn/element/__ID__', { site: site.handle }),
            }|json_encode|raw }}</script>

            {# The legend and the status sit in a bar above the canvas rather than floating over
               it: anything laid over the drawing hides whichever nodes the layout puts under it. #}
            <div class="yarn-map-bar">
                <div class="yarn-legend" data-yarn-legend>
                    {% for key, label in kinds %}
                        <button type="button" data-kind="{{ key }}" aria-pressed="true">
                            <span class="yarn-dot" data-kind="{{ key }}"></span>{{ label }}
                        </button>
                    {% endfor %}
                </div>
                <div class="yarn-map-status" data-yarn-status role="status">{{ "Loading…"|t('yarn') }}</div>
            </div>

            <div class="yarn-map-canvas">
                <svg role="img" aria-label="{{ "Relation map"|t('yarn') }}"></svg>

                <div class="yarn-detail" data-yarn-detail hidden></div>

                <div class="yarn-map-controls">
                    <button type="button" class="btn small" data-yarn-fit>{{ "Fit"|t('yarn') }}</button>
                    <button type="button" class="btn small" data-yarn-shake>{{ "Re-settle"|t('yarn') }}</button>
                </div>
            </div>
        </div>

        <p class="light yarn-map-help">
            {{ "Drag to pan, scroll to zoom, click an element to light up its relations, double-click to see only its neighbourhood."|t('yarn') }}
            {% if graph.skippedKinds %}
                <br>
                {{ "Not scanned: {sources}. Switch them on under Settings."|t('yarn', { sources: graph.skippedKinds|join(', ') }) }}
            {% endif %}
        </p>
    </div>
{% endblock %}
